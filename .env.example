# --- Database (Neon) -----------------------------------------------------
# From the Neon console > your project > Connection string.
# DATABASE_URL is the POOLED string (host contains "-pooler"). The app uses it.
# DIRECT_URL is the direct string. Prisma migrations use it.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js / Entra ID SSO ----------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
# On Vercel this is your deployment URL, e.g. https://marketing.rclick.com
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Entra ID app registration (Azure portal > App registrations)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0"

# Comma-separated emails granted the MANAGER role on first sign-in.
# Everyone else who signs in gets MARKETING.
MANAGER_EMAILS="baiju@rclick.com"
# Recommended: lock sign-in to the Right Click tenant only.
ALLOWED_TENANT_ID=""

# --- Teams ---------------------------------------------------------------
# The Power Automate HTTP POST URL, or a channel Incoming Webhook URL.
# A group chat cannot have an Incoming Webhook — use a flow for those.
# The whole URL is a credential: it ends in a &sig= signature.
# This is the only place the webhook is configured; changing it needs a
# redeploy. Run "npm run teams:payload" for the request body schema to
# paste into a Power Automate trigger.
TEAMS_WEBHOOK_URL=""

# --- Cron ----------------------------------------------------------------
# Vercel Cron sends this automatically as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# --- Local development ---------------------------------------------------
# Lets you sign in with just an email, skipping Entra. Ignored in production.
DEV_LOGIN="false"
# Office timezone used for "today" and for which day time counts toward.
BUSINESS_TIMEZONE="America/Los_Angeles"
