// Right Click Marketing Desk — data model
//
// The core idea: a Task is the *definition* of work ("Check SEO rankings").
// A TaskOccurrence is a concrete instance of it due on a date. One-off tasks
// have exactly one occurrence; recurring tasks get a fresh one each cycle.
// An occurrence is never auto-hidden — an overdue one keeps showing up until
// somebody closes it. That is the whole point of this system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon: the pooled connection string, used by the app at runtime.
  url       = env("DATABASE_URL")
  // Neon: the direct (non-pooled) string. Migrations need a real session,
  // which the pgbouncer pooler cannot give them.
  directUrl = env("DIRECT_URL")
}

enum Role {
  MARKETING
  MANAGER
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum Cadence {
  NONE
  DAILY
  WEEKDAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum OccurrenceStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  SKIPPED
}

enum TimeSource {
  TIMER
  MANUAL
}

enum PostStatus {
  DRAFT
  POSTED
  FAILED
}

// ---------------------------------------------------------------- identity

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MARKETING)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  assignedTasks  Task[]             @relation("assignee")
  createdTasks   Task[]             @relation("creator")
  completed      TaskOccurrence[]   @relation("completedBy")
  timeEntries    TimeEntry[]
  activeTimer    ActiveTimer?
  summaries      DailySummary[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ------------------------------------------------------------------- work

model Category {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#0098d5")
  tasks Task[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  categoryId  String?
  priority    Priority @default(MEDIUM)

  // Recurrence. NONE means a one-off.
  cadence     Cadence  @default(NONE)
  // "every N cadences" — 1 for a plain weekly, 2 for every other week.
  interval    Int      @default(1)
  // WEEKLY/BIWEEKLY: 0=Sun..6=Sat. MONTHLY and longer: day of month (1-31, 31 = last day).
  anchorDay   Int?
  // Recurring work is scheduled forward from this date.
  startDate   DateTime @db.Date @default(now())
  // Stop generating after this date. Null = forever.
  endDate     DateTime? @db.Date

  estimateMinutes Int?
  assigneeId      String?
  createdById     String?
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignee    User?            @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("creator", fields: [createdById], references: [id], onDelete: SetNull)
  occurrences TaskOccurrence[]

  @@index([archivedAt, cadence])
  @@index([assigneeId])
}

model TaskOccurrence {
  id        String           @id @default(cuid())
  taskId    String
  dueDate   DateTime         @db.Date
  status    OccurrenceStatus @default(OPEN)
  // Overrides the task priority for this instance only (a manager bumping one week).
  priority  Priority?
  // Manual ordering inside a day. Lower sorts first.
  sortOrder Int              @default(0)
  notes     String?          @db.Text

  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User?       @relation("completedBy", fields: [completedById], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  activeTimer ActiveTimer?

  // One occurrence of a given task per due date. Makes the generator idempotent.
  @@unique([taskId, dueDate])
  @@index([status, dueDate])
  @@index([dueDate])
}

model TimeEntry {
  id           String     @id @default(cuid())
  occurrenceId String
  userId       String
  minutes      Int
  note         String?    @db.Text
  source       TimeSource @default(MANUAL)
  // The business day this time counts toward. Kept separate from createdAt so
  // late entries ("I forgot to log Tuesday") land on the right day.
  workDate     DateTime   @db.Date
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime   @default(now())

  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workDate])
  @@index([occurrenceId])
}

// At most one running timer per person. Enforced by the unique userId.
model ActiveTimer {
  id           String   @id @default(cuid())
  userId       String   @unique
  occurrenceId String   @unique
  startedAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
}

model DailySummary {
  id           String     @id @default(cuid())
  userId       String
  date         DateTime   @db.Date
  body         String     @db.Text
  tomorrowPlan String?    @db.Text
  totalMinutes Int        @default(0)
  status       PostStatus @default(DRAFT)
  postedAt     DateTime?
  postError    String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Setting {
  key   String @id
  value String @db.Text
}
